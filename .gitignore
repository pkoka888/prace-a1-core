# Environment variables
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ocr_venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# In-repo operational A1 inputs (PII-bearing, gitignored, never commit)
# These are the relocated A1_PRIVATE_DIR contents, kept inside the repo and
# excluded from version control. Set A1_PRIVATE_DIR to the repo root to use them.
a1/
# workflows/a1/ is the tracked WF-A1 documentation directory (versioned as
# a1form-generator); re-include it so the rule above keeps matching only the
# PII-bearing operational inputs and test leftovers.
!/workflows/a1/
# tests/a1/ is the tracked A1 test suite (versioned); re-include it.
!/tests/a1/
scans/
evidence/
ocr/

# Protected portal runtime and secrets (real data, never commit)
runtime/portal/
runtime/free-model-eval/
secrets/
.runtime-config/

# Protected, disposable PLAN-A1 history-rewrite workspace (formerly Plan Q); may temporarily contain
# sensitive historical Git objects and must never be staged or published.
.history-remediation/

# Data files — PII-bearing, never commit
data/
employees/scans/
employees/scans/ocr_results_stepfun.json
data/employees/
data/employees_normalized.json
data/a1_forms/

# Reports (may contain PII)
reports/

# Private operator review inputs and rendered review material
private/
output/final/
output/review-images/

# Generated A1 artifacts — contain per-person identity data
output/
output/provisional/
output/provisional-previews/
output/provisional-contact-sheets/
output/quarantine-*/
output/provisional.backup-*/

# Local archive: files moved out of the active tree are preserved under
# .archive/<original-relative-path> per the convention in .archive/README.md.
# The README itself is the only tracked file in this directory.
# (Ignore everything inside the dir, then explicitly allow the README — a
# top-level `.archive/` ignore would also hide the README from git's view.)
.archive/*
!.archive/README.md
output/*.tar.gz
*.tar.gz
archive/**/*.png
archive/**/*.pdf
archive/**/phase1_data_snapshot.json
archive/**/generation_manifest.json
archive/**/CLIENT_CONFIRMATION_CHECKLIST.md
archive/**/FINAL_VISUAL_VERIFICATION.csv
archive/**/verification_table.csv

# Script backups
scripts/*.backup
scripts/*.bak

# PII-bearing operational snapshots (names/DOB) not part of the committed tree
archive/**/verification_table.csv

# OCR and stepfun results (contain extracted identity data)
employees/scans/ocr_results_stepfun.json

# n8n workflow exports (may contain PII references)
*.n8n-workflow

# Operational runtime artifacts (never commit)
db.sqlite3
server.pid

# NOTE: do NOT add a blanket `*.json` rule here. Policy/configuration and
# synthetic test fixtures are legitimate tracked JSON. PII-bearing JSON is
# excluded by the precise paths above (data/, employees/scans/, private/,
# output/, reports/, archive/**) and must never be committed.
scans/

# Local environment variants; only reviewed synthetic examples may be tracked.
.env.*
!.env.example
# All runtime outputs are local; source and fixtures belong outside runtime/.
/runtime/
# The working database holds real client identities. It is never committed:
# Git history is permanent, and this repository's published history was
# once rewritten to remove PII-bearing ancestry. The rule is also enforced
# by scripts/check_git_content.py, so removing it here cannot expose the
# data. See docs/operations/local-database-backup.md.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
/:memory:.ses

# Scratch A1 review inputs and per-person scratch directories. These hold
# real identity data (name, date of birth, insurance number) in a plain CSV
# or a working copy of the private input tree. They are disposable local
# artifacts: the canonical inputs live under the private a1/ directory and
# the generated artifacts under output/, both of which are ignored above.
# They are ignored here so that a wide "git add" cannot publish them.
tomas_nistor_review.csv
temp_orig
temp_orig.py
test_output/
test_tomas_nistor/

# Plan AC research corpora — experimental market-research-evidence skill
# Per docs/research/2026-09-07-research-audit.md disposition: retain pending review.
# Skill activation requires the four-gate checklist (Pilot 1 + Pilot 2 evidence,
# review, safety, reproducibility) before any of these can be tracked.
/research/acquisition/
!/research/acquisition/synthetic-mini-pilot/
/research/benchmark-experimental/
/research/pilot/
/research/processed/
/research/review/*.json
!/research/review/operator-review.template.json
!/research/review/review-queue.schema.json
!/research/review/review-response.schema.json
