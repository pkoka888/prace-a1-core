{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project approval register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/definitions/record"}
    }
  },
  "definitions": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "recommended", "selected", "approval"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9._-]+$"},
        "label": {"type": "string", "minLength": 1},
        "recommended": {"type": "string", "minLength": 1},
        "selected": {"type": "string", "minLength": 1},
        "approval": {"enum": ["approved", "rejected", "pending"]},
        "deviation_reason": {"type": ["string", "null"]}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9._-]+$"},
        "label": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "passed", "failed", "not-required"]},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required_gate"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "required_gate": {"enum": ["approved", "validated", "implementation-open", "activation-open"]}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "scope", "owner", "approver", "human_decision", "validation", "implementation_gate", "activation_gate", "choices", "checks", "dependencies", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "approver": {"type": "string", "minLength": 1},
        "human_decision": {"enum": ["proposed", "approved", "rejected"]},
        "approved_at": {"type": ["string", "null"], "format": "date"},
        "approval_evidence": {"type": ["string", "null"]},
        "validation": {"enum": ["pending", "passed", "failed", "not-required"]},
        "implementation_gate": {"enum": ["open", "blocked"]},
        "implementation_gate_reason": {"type": ["string", "null"]},
        "activation_gate": {"enum": ["open", "blocked", "not-applicable"]},
        "activation_gate_reason": {"type": ["string", "null"]},
        "choices": {"type": "array", "items": {"$ref": "#/definitions/choice"}},
        "checks": {"type": "array", "items": {"$ref": "#/definitions/check"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/definitions/dependency"}},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
