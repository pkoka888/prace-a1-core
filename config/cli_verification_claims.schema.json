{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cli_verification_claims.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_assistance", "products", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "model_assistance": {
      "type": "object",
      "required": ["enabled", "authority", "activation", "purpose", "never", "sampling", "output_contract", "cost_and_privacy"],
      "properties": {
        "enabled": {"const": false},
        "authority": {"const": "advisory_only"},
        "activation": {"const": "explicit_operator_opt_in"},
        "purpose": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "never": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sampling": {"type": "object"},
        "output_contract": {
          "type": "object",
          "required": ["forbidden_statuses"],
          "properties": {
            "forbidden_statuses": {
              "type": "array",
              "allOf": [
                {"contains": {"const": "VERIFIED_RUNTIME"}},
                {"contains": {"const": "CONTRADICTED"}}
              ]
            }
          }
        },
        "cost_and_privacy": {"type": "object"}
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "binary", "safe_probes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "label": {"type": "string", "minLength": 1},
          "binary": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"},
          "version_args": {"$ref": "#/definitions/args"},
          "help_args": {"$ref": "#/definitions/args"},
          "safe_probes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "args", "format", "purpose"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
                "args": {"$ref": "#/definitions/args"},
                "format": {"enum": ["text", "json", "jsonl"]},
                "purpose": {"type": "string", "minLength": 1},
                "run": {"type": "boolean"},
                "reason": {"type": "string", "minLength": 1}
              },
              "allOf": [
                {"if": {"properties": {"run": {"const": false}}, "required": ["run"]}, "then": {"required": ["reason"]}}
              ]
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "product", "statement", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "product": {"type": "string"},
          "statement": {"type": "string", "minLength": 1},
          "source": {"enum": ["help", "probe", "manual"]},
          "contains": {"type": "string", "minLength": 1},
          "probe": {"type": "string"},
          "expect": {"enum": ["json", "exit_zero", "contains"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"source": {"const": "help"}}, "required": ["source"]}, "then": {"required": ["contains"]}},
          {"if": {"properties": {"source": {"const": "probe"}}, "required": ["source"]}, "then": {"required": ["probe", "expect"]}},
          {"if": {"properties": {"expect": {"const": "contains"}}, "required": ["expect"]}, "then": {"required": ["contains"]}},
          {"if": {"properties": {"source": {"const": "manual"}}, "required": ["source"]}, "then": {"required": ["reason"]}}
        ]
      }
    }
  },
  "definitions": {
    "args": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
