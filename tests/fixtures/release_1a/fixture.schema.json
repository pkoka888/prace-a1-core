{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["_fiction"],
    "properties": {
      "_fiction": {"type": "string", "minLength": 20},
      "id": {"type": "string", "minLength": 1},
      "case_id": {"type": "string", "minLength": 1},
      "organization_id": {"type": "string", "pattern": "^org-synthetic-"}
    },
    "anyOf": [{"required": ["id"]}, {"required": ["case_id"]}]
  }
}
