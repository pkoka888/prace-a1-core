{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["report_id", "result_id", "status", "metrics", "label_counts", "generated_at"],
  "properties": {
    "report_id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "result_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "status": {"enum": ["scored", "unproven"]},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["factual_accuracy", "citation_precision"], "properties": {"factual_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "citation_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "label_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "generated_at": {"type": "string", "format": "date-time"}, "issues": {"type": "array", "items": {"type": "string"}}
  }
}
