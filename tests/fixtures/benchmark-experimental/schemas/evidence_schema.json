{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["evidence_id", "question_id", "claim_ids", "source_url", "final_url", "retrieved_at", "effective_date", "source_type", "content_hash", "supported_excerpt"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^ev-[a-z0-9-]+$"}, "question_id": {"type": "string", "pattern": "^q-[a-z0-9-]+$"},
    "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^c-[a-z0-9-]+$"}},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "final_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "retrieved_at": {"type": "string", "format": "date-time"}, "effective_date": {"type": ["string", "null"], "format": "date"},
    "source_type": {"enum": ["official", "vendor", "repository", "registry", "academic", "secondary"]},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "supported_excerpt": {"type": "string", "minLength": 1}
  }
}
