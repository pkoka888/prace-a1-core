{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_id", "version", "cutoff_date", "repair_notes", "public_questions", "metadata"],
  "properties": {
    "benchmark_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"const": "0.2.0"},
    "cutoff_date": {"type": "string", "format": "date"},
    "repair_notes": {"type": "string", "minLength": 1},
    "public_questions": {
      "type": "array", "minItems": 18, "maxItems": 18,
      "items": {"$ref": "#/definitions/question"}
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["created_by", "created_date", "total_count", "public_count", "holdout_count"],
      "properties": {
        "created_by": {"type": "string", "minLength": 1},
        "created_date": {"type": "string", "format": "date"},
        "total_count": {"const": 25},
        "public_count": {"const": 18},
        "holdout_count": {"const": 7}
      }
    }
  },
  "definitions": {
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "prompt", "expected_fields"],
      "properties": {
        "id": {"type": "string", "pattern": "^q-[a-z0-9-]+$"},
        "category": {"enum": ["vendor_prices_tiers_vat", "invoice_processing", "accounting_exports", "github_metrics", "license_availability", "non_disclosed", "conflict_resolution", "entity_resolution"]},
        "prompt": {"type": "string", "minLength": 10},
        "expected_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "should_abstain": {"type": "boolean"}
      }
    }
  }
}
