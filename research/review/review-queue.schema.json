{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tvoje.info/schemas/research-review-queue-1.1.json",
  "title": "Plan AC non-authoritative operator review queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_version",
    "authority",
    "queue_status",
    "generated_as_of",
    "input_binding",
    "query_pack_binding",
    "task_counts",
    "tasks"
  ],
  "properties": {
    "queue_version": { "const": "1.1" },
    "authority": { "const": "non_authoritative_operator_work_queue" },
    "queue_status": { "const": "awaiting_operator_review" },
    "generated_as_of": { "type": "string", "format": "date" },
    "input_binding": { "$ref": "#/definitions/file_binding" },
    "query_pack_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "query_pack_version", "query_pack_hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "query_pack_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "query_pack_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "task_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "claim", "source_integrity", "total"],
      "properties": {
        "entity": { "type": "integer", "minimum": 0 },
        "claim": { "type": "integer", "minimum": 0 },
        "source_integrity": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/definitions/task" }
    },
    "collection_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_id", "collector_kind", "execution_instance_id", "identity_verification", "config_digest", "collection_method", "source_policy_version", "started_at", "completed_at"],
      "properties": {
        "collector_id": { "type": "string", "minLength": 1 },
        "collector_kind": { "enum": ["human", "agent", "automation"] },
        "execution_instance_id": { "type": "string", "minLength": 1 },
        "identity_verification": { "enum": ["operator_attested", "unverified"] },
        "config_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "collection_method": { "enum": ["manual", "agent_assisted", "automated", "hybrid"] },
        "source_policy_version": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "provider": { "type": "string" },
        "model": { "type": "string" }
      }
    }
  },
  "definitions": {
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "run_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "format_version": { "type": "string", "minLength": 1 }
      }
    },
    "operator_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "reviewed_at",
        "verdict",
        "notes",
        "replacement_source_url"
      ],
      "properties": {
        "reviewer_id": { "type": "null" },
        "reviewed_at": { "type": "null" },
        "verdict": { "type": "null" },
        "notes": { "type": "null" },
        "replacement_source_url": { "type": "null" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_type",
        "entity_id",
        "entity_title",
        "cohort",
        "source_url",
        "source_publication_date",
        "source_access_date",
        "claim_field",
        "claim_value",
        "claim_confidence",
        "result_status",
        "evidence_id",
        "evidence_ids",
        "source_task_ids",
        "references",
        "instructions",
        "operator"
      ],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "task_type": { "enum": ["entity", "claim", "source_integrity"] },
        "entity_id": { "type": "string", "minLength": 1 },
        "entity_title": { "type": "string", "minLength": 1 },
        "cohort": { "type": "string", "minLength": 1 },
        "source_url": { "type": ["string", "null"], "pattern": "^https://" },
        "source_publication_date": { "type": ["string", "null"], "format": "date" },
        "source_access_date": { "type": ["string", "null"], "format": "date" },
        "claim_field": { "type": ["string", "null"] },
        "claim_value": { "$ref": "#/definitions/json_value" },
        "claim_confidence": { "type": ["string", "null"] },
        "claim_provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["applicability", "enumeration_scope", "captured_at"],
          "properties": {
            "applicability": { "type": "string", "minLength": 1 },
            "enumeration_scope": { "type": "string", "minLength": 1 },
            "captured_at": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "result_status": { "type": ["string", "null"] },
        "evidence_id": { "type": ["string", "null"] },
        "evidence_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_task_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^source-integrity::[a-f0-9]{64}$" }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["entity_id", "claim_field", "evidence_id"],
            "properties": {
              "entity_id": { "type": "string", "minLength": 1 },
              "claim_field": { "type": "string", "minLength": 1 },
              "evidence_id": { "type": "string", "minLength": 1 },
              "evidence_class": { "type": "string", "minLength": 1 },
              "verification_status": { "type": "string", "minLength": 1 },
              "retrieved_at": { "type": "string", "format": "date-time" },
              "locator": { "type": ["string", "null"] }
            }
          }
        },
        "instructions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "operator": { "$ref": "#/definitions/operator_fields" }
      }
    },
    "json_value": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/definitions/json_value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/definitions/json_value" } }
      ]
    }
  }
}
