{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan AC synthetic collector mini-pilot fixture set",
  "type": "object", "additionalProperties": false,
  "required": ["fixture_set_version", "synthetic_marker", "evidence_scope", "query_pack_hash", "protocol_config_digest", "fixture_set_hash", "retrieved_at", "sources", "decision_templates"],
  "properties": {
    "fixture_set_version": {"const": "1.0.0"},
    "synthetic_marker": {"const": "SYNTHETIC_PLAN_AC_MINI_PILOT_DO_NOT_USE_AS_MARKET_EVIDENCE"},
    "evidence_scope": {"const": "synthetic_fixture_only_not_market_evidence"},
    "query_pack_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_config_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fixture_set_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retrieved_at": {"const": "2026-08-14T12:00:00Z"},
    "sources": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entity_id", "source_id", "body_text"],
        "properties": {
          "entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "source_id": {"type": "string", "pattern": "^fixture-[a-z][a-z0-9-]*$"},
          "body_text": {"type": "string", "minLength": 80, "maxLength": 450}
        }
      }
    },
    "decision_templates": {
      "type": "object", "additionalProperties": false,
      "required": ["oss_invoice", "czech_invoice_software"],
      "properties": {
        "oss_invoice": {"$ref": "#/definitions/templates9"},
        "czech_invoice_software": {"$ref": "#/definitions/templates14"}
      }
    }
  },
  "definitions": {
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "support_status", "value", "locator", "query_term"],
      "properties": {
        "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "support_status": {"const": "proven"}, "value": {},
        "locator": {"const": "synthetic support detail"},
        "query_term": {"type": "string", "minLength": 2}
      }
    },
    "templates9": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/definitions/decision"}},
    "templates14": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/definitions/decision"}}
  }
}
