      "output": {"kind": "mapping_function", "name": "identity_exact", "result_type": "string"},
      "enumeration_behavior": "scalar_proposal",
      "source_languages": ["en"],
      "requires_operator_review": true,
      "notes": "Only an exact SPDX token is preserved; the rule does not infer licence compatibility or legal effect."
    },
    {
