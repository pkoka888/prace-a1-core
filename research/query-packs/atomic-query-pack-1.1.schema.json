{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prace-v-nemecku.tvoje.info/research/query-packs/atomic-query-pack-1.1.schema.json",
  "title": "Plan AC frozen atomic query pack v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_pack_version", "result_format_version", "query_pack_hash", "hash_algorithm", "source_policy_version", "capture_window", "vocabularies", "lanes"],
  "properties": {
    "query_pack_version": {"const": "1.1.0"},
    "result_format_version": {"const": "atomic-results-1.1"},
    "query_pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_algorithm": {"const": "sha256-canonical-json-without-query_pack_hash"},
    "source_policy_version": {"type": "string", "minLength": 1},
    "capture_window": {
      "type": "object", "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": {"type": "string", "format": "date-time"},
        "ends_at": {"type": "string", "format": "date-time"}
      }
    },
    "vocabularies": {
      "type": "object", "additionalProperties": false,
      "required": ["result_status", "evidence_class", "verification_status", "applicability", "enumeration_scope", "claim_confidence"],
      "properties": {
        "result_status": {"$ref": "#/definitions/vocabulary"},
        "evidence_class": {"$ref": "#/definitions/vocabulary"},
        "verification_status": {"$ref": "#/definitions/vocabulary"},
        "applicability": {"$ref": "#/definitions/vocabulary"},
        "enumeration_scope": {"$ref": "#/definitions/vocabulary"},
        "claim_confidence": {"$ref": "#/definitions/vocabulary"}
      }
    },
    "lanes": {
      "type": "object", "additionalProperties": false,
      "required": ["oss_invoice", "czech_invoice_software"],
      "properties": {
        "oss_invoice": {"$ref": "#/definitions/lane"},
        "czech_invoice_software": {"$ref": "#/definitions/lane"}
      }
    }
  },
  "definitions": {
    "vocabulary": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "canonical_root_url", "allowed_official_source_roots"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "canonical_root_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "allowed_official_source_roots": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "entities", "fields"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "entities": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/definitions/entity"}},
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/field"}}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "importance", "value_type", "comparison_rule", "evidence_required", "not_applicable_allowed"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "question": {"type": "string", "minLength": 1},
        "importance": {"enum": ["critical", "noncritical", "pricing"]},
        "value_type": {"enum": ["boolean", "date", "integer", "string", "string_list", "pricing"]},
        "comparison_rule": {"enum": ["exact", "normalized_set", "snapshot", "pricing"]},
        "evidence_required": {"type": "boolean"},
        "not_applicable_allowed": {"type": "boolean"},
        "allowed_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "requires_enumeration_scope": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
