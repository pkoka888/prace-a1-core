{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prace-v-nemecku.tvoje.info/research/query-packs/collector-execution-1.2.schema.json",
  "title": "Plan AC collector proposal execution v1.2",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "run_id", "execution_instance_id", "authority_classification", "query_pack", "protocol", "normalization_rules", "contract_schema", "capture_manifests", "collector", "inspections", "summary"],
  "properties": {
    "format_version": {"const": "collector-execution-1.2"},
    "run_id": {"$ref": "#/definitions/id"},
    "execution_instance_id": {"$ref": "#/definitions/id"},
    "authority_classification": {"const": "collector_proposed"},
    "query_pack": {"$ref": "#/definitions/document_binding"},
    "protocol": {"$ref": "#/definitions/document_binding"},
    "normalization_rules": {"$ref": "#/definitions/document_binding"},
    "contract_schema": {"$ref": "#/definitions/document_binding"},
    "capture_manifests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/document_binding"}},
    "collector": {"$ref": "#/definitions/collector"},
    "inspections": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/inspection"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "proven", "conflicted", "does_not_establish", "not_inspected"],
      "properties": {"total": {"type": "integer", "minimum": 1}, "proven": {"type": "integer", "minimum": 0}, "conflicted": {"type": "integer", "minimum": 0}, "does_not_establish": {"type": "integer", "minimum": 0}, "not_inspected": {"type": "integer", "minimum": 0}}
    }
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_ref": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "document_binding": {"type": "object", "additionalProperties": false, "required": ["path", "byte_sha256", "semantic_sha256"], "properties": {"path": {"$ref": "#/definitions/safe_ref"}, "byte_sha256": {"$ref": "#/definitions/sha256"}, "semantic_sha256": {"$ref": "#/definitions/sha256"}}},
    "file_binding": {"type": "object", "additionalProperties": false, "required": ["path", "byte_sha256"], "properties": {"path": {"$ref": "#/definitions/safe_ref"}, "byte_sha256": {"$ref": "#/definitions/sha256"}}},
    "collector": {"type": "object", "additionalProperties": false, "required": ["collector_id", "provider", "model", "identity_verification", "implementation", "config", "tools"], "properties": {"collector_id": {"type": "string", "minLength": 1}, "provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "identity_verification": {"const": "unverified"}, "implementation": {"$ref": "#/definitions/file_binding"}, "config": {"$ref": "#/definitions/document_binding"}, "tools": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}}}},
    "source_ref": {"type": "object", "additionalProperties": false, "required": ["capture_manifest_path", "capture_result_id"], "properties": {"capture_manifest_path": {"$ref": "#/definitions/safe_ref"}, "capture_result_id": {"$ref": "#/definitions/id"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["source", "mapping_rule_id", "raw_value", "proposed_value", "supporting_text", "authority_classification"], "properties": {"source": {"$ref": "#/definitions/source_ref"}, "mapping_rule_id": {"$ref": "#/definitions/id"}, "raw_value": {}, "proposed_value": {}, "supporting_text": {"type": "string", "minLength": 1}, "authority_classification": {"const": "collector_proposed"}}},
    "enumerand": {"type": "object", "additionalProperties": false, "required": ["raw_value", "mapped_value", "mapping_rule_id"], "properties": {"raw_value": {"type": "string", "minLength": 1}, "mapped_value": {"type": "string", "minLength": 1}, "mapping_rule_id": {"$ref": "#/definitions/id"}}},
    "enumeration_scope": {"type": "object", "additionalProperties": false, "required": ["completeness", "captured_enumerands", "mapped_enumerands", "unmapped_enumerands"], "properties": {"completeness": {"enum": ["partial", "complete"]}, "captured_enumerands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "mapped_enumerands": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/enumerand"}}, "unmapped_enumerands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "inspection": {"type": "object", "additionalProperties": false, "required": ["entity_id", "field_id", "inspection_status", "sources", "observations", "reason"], "properties": {"entity_id": {"type": "string", "minLength": 1}, "field_id": {"type": "string", "minLength": 1}, "inspection_status": {"enum": ["proven", "conflicted", "does_not_establish", "not_inspected"]}, "not_inspected_reason": {"enum": ["not_attempted", "out_of_scope"]}, "sources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/source_ref"}}, "observations": {"type": "array", "items": {"$ref": "#/definitions/observation"}}, "enumeration_scope": {"$ref": "#/definitions/enumeration_scope"}, "reason": {"type": "string", "minLength": 8}}}
  }
}
