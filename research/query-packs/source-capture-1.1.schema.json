{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tvoje.info/schemas/source-capture-1.1.schema.json",
  "title": "Plan AC query-pack-bound public source capture request v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "query_pack_version", "query_pack_hash", "requests"],
  "properties": {
    "schema_version": {"const": "source-capture-1.1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "query_pack_version": {"const": "1.1.0"},
    "query_pack_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requests": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/definitions/request"}}
  },
  "definitions": {
    "field_target": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "field_id"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "url", "method", "field_targets"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "method": {"enum": ["HEAD", "GET"]},
        "field_targets": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {"$ref": "#/definitions/field_target"}, "uniqueItems": true
        },
        "excerpt": {
          "type": "object", "additionalProperties": false,
          "required": ["selector", "terms", "max_chars"],
          "properties": {
            "selector": {"const": "term-window"},
            "terms": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 80}, "uniqueItems": true},
            "max_chars": {"type": "integer", "minimum": 20, "maximum": 500}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"method": {"const": "HEAD"}}}, "then": {"not": {"required": ["excerpt"]}}},
        {"if": {"properties": {"method": {"const": "GET"}}}, "then": {"required": ["excerpt"]}}
      ]
    }
  }
}
