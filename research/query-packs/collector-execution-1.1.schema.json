{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prace-v-nemecku.tvoje.info/research/query-packs/collector-execution-1.1.schema.json",
  "title": "Plan AC collector execution manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "evidence_scope", "run_id", "execution_instance_id", "authority_classification", "operator_attestation", "query_pack", "protocol", "contract_schema", "collector", "capture", "sources", "inspections"],
  "properties": {
    "format_version": {"const": "collector-execution-1.1"},
    "evidence_scope": {"enum": ["collector_proposal_not_market_evidence", "synthetic_fixture_only_not_market_evidence", "operator_reviewed_research"]},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "execution_instance_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
    "authority_classification": {"enum": ["collector_proposed", "synthetic_fixture_verified", "operator_verified"]},
    "operator_attestation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision_ref", "decision_sha256", "decision_id"],
          "properties": {
            "decision_ref": {"$ref": "#/definitions/safe_ref"},
            "decision_sha256": {"$ref": "#/definitions/sha256"},
            "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"}
          }
        }
      ]
    },
    "query_pack": {"$ref": "#/definitions/query_pack_binding"},
    "protocol": {"$ref": "#/definitions/protocol_binding"},
    "contract_schema": {"$ref": "#/definitions/contract_schema_binding"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_id", "provider", "model", "identity_verification", "config_digest", "implementation", "prompt", "config", "tools"],
      "properties": {
        "collector_id": {"type": "string", "minLength": 1},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "identity_verification": {"enum": ["unverified", "operator_attested"]},
        "config_digest": {"$ref": "#/definitions/sha256"},
        "implementation": {"$ref": "#/definitions/file_binding"},
        "prompt": {"$ref": "#/definitions/versioned_file_binding"},
        "config": {"$ref": "#/definitions/versioned_file_binding"},
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/definitions/source"}},
    "inspections": {"type": "array", "items": {"$ref": "#/definitions/inspection"}}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_ref": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_sha256"],
      "properties": {
        "path": {"$ref": "#/definitions/safe_ref"},
        "byte_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "versioned_file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_sha256", "version"],
      "properties": {
        "path": {"$ref": "#/definitions/safe_ref"},
        "byte_sha256": {"$ref": "#/definitions/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "document_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_sha256", "semantic_sha256"],
      "properties": {
        "path": {"$ref": "#/definitions/safe_ref"},
        "byte_sha256": {"$ref": "#/definitions/sha256"},
        "semantic_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "query_pack_binding": {
      "allOf": [
        {"$ref": "#/definitions/document_binding"},
        {"properties": {"path": {"const": "research/query-packs/plan-ac-core-1.1.json"}}}
      ]
    },
    "protocol_binding": {
      "allOf": [
        {"$ref": "#/definitions/document_binding"},
        {"properties": {"path": {"const": "research/query-packs/plan-ac-collector-protocol-1.1.json"}}}
      ]
    },
    "contract_schema_binding": {
      "allOf": [
        {"$ref": "#/definitions/document_binding"},
        {"properties": {"path": {"const": "research/query-packs/collector-execution-1.1.schema.json"}}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_id", "capture_manifest_ref", "capture_manifest_sha256", "capture_run_id", "capture_mode", "capture_result_id", "capture_result_sha256", "requested_url", "final_url", "redirect_chain", "http_status", "retrieved_at", "content_type", "verification_status", "response_sha256", "excerpt_sha256", "excerpt_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "entity_id": {"type": "string", "minLength": 1},
        "capture_manifest_ref": {"type": "string", "pattern": "^research/acquisition/source-captures/[a-z0-9][a-z0-9._-]*/manifest\\.json$"},
        "capture_manifest_sha256": {"$ref": "#/definitions/sha256"},
        "capture_run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "capture_mode": {"enum": ["fixture", "live"]},
        "capture_result_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "capture_result_sha256": {"$ref": "#/definitions/sha256"},
        "requested_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "final_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "redirect_chain": {"type": "array", "maxItems": 5, "items": {
          "type": "object", "additionalProperties": false, "required": ["status", "from", "to"],
          "properties": {
            "status": {"enum": [301, 302, 303, 307, 308]},
            "from": {"type": "string", "format": "uri", "pattern": "^https://"},
            "to": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        }},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_type": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["verified", "unverified", "unreachable", "invalid"]},
        "response_sha256": {"$ref": "#/definitions/sha256"},
        "excerpt_sha256": {"$ref": "#/definitions/sha256"},
        "excerpt_ref": {"$ref": "#/definitions/safe_ref"}
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "field_id", "source_ids", "locators", "observations", "inspected_sections", "query_terms", "support_status", "reason"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "field_id": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "locators": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "locator"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 8}
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "value", "excerpt_span", "supporting_text"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "value": {},
              "excerpt_span": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "items": {"type": "integer", "minimum": 0}
              },
              "supporting_text": {"type": "string", "minLength": 1}
            }
          }
        },
        "inspected_sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "query_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "support_status": {"enum": ["proven", "does_not_establish", "conflicted"]},
        "reason": {"type": "string", "minLength": 8}
      }
    }
  }
}
