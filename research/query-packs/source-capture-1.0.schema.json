{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tvoje.info/schemas/source-capture-1.0.schema.json",
  "title": "Plan AC bounded public source capture request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "requests"],
  "properties": {
    "schema_version": {"const": "source-capture-1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/definitions/request"}
    }
  },
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "method"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "method": {"enum": ["HEAD", "GET"]},
        "excerpt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_target", "selector", "terms", "max_chars"],
          "properties": {
            "claim_target": {"type": "string", "minLength": 1, "maxLength": 160},
            "selector": {"const": "term-window"},
            "terms": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {"type": "string", "minLength": 2, "maxLength": 80},
              "uniqueItems": true
            },
            "max_chars": {"type": "integer", "minimum": 20, "maximum": 500}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "HEAD"}}},
          "then": {"not": {"required": ["excerpt"]}}
        },
        {
          "if": {"properties": {"method": {"const": "GET"}}},
          "then": {"required": ["excerpt"]}
        }
      ]
    }
  }
}
