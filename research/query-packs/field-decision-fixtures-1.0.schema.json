{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan AC field-decision replay fixtures 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_version", "purpose", "query_pack_binding", "entity_ids", "cases"],
  "properties": {
    "fixture_version": {"const": "field-decision-fixtures-1.0"},
    "purpose": {"const": "synthetic-replay-only-not-market-evidence"},
    "query_pack_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "query_pack_version", "query_pack_hash", "file_sha256"],
      "properties": {
        "path": {"const": "research/query-packs/plan-ac-core-1.1.json"},
        "query_pack_version": {"const": "1.1.0"},
        "query_pack_hash": {"const": "69ea1e988271dafaaea0ea84cc75e6eac8ad7c884ec4f66212ce57a3a68a3819"},
        "file_sha256": {"const": "db652791b73e327bbc2047c369b9c8c71d424505898945d02cd000e9cc07151f"}
      }
    },
    "entity_ids": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "cases": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "entity_id", "lane", "field_id", "candidate_value", "evidence", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "entity_id": {"type": "string"},
          "lane": {"enum": ["oss_invoice", "czech_invoice_software"]},
          "field_id": {"type": "string", "minLength": 1},
          "candidate_value": {},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/evidence"}},
          "expected": {"enum": ["supports", "does_not_establish", "conflicts"]}
        }
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entity_id", "field_id", "evidence_class", "url", "page_title", "captured_at", "locator", "synthetic_capture", "capture_sha256", "synthetic_excerpt", "excerpt_sha256", "assertions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "entity_id": {"type": "string"},
        "field_id": {"type": "string"},
        "evidence_class": {"enum": ["official_primary", "official_secondary", "independent_primary", "independent_secondary", "repository_metadata"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "page_title": {"type": "string", "minLength": 8},
        "captured_at": {"type": "string", "format": "date-time"},
        "locator": {"type": "string", "pattern": "^synthetic:(line|paragraph):[1-9][0-9]*$"},
        "synthetic_capture": {"type": "string", "minLength": 20, "maxLength": 300},
        "capture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "synthetic_excerpt": {"type": "string", "minLength": 20, "maxLength": 240},
        "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "assertions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["field_id", "effect", "value"],
            "properties": {
              "field_id": {"type": "string"},
              "effect": {"enum": ["supports", "contradicts"]},
              "value": {}
            }
          }
        }
      }
    }
  }
}
