{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prace-v-nemecku.tvoje.info/research/query-packs/atomic-query-pack.schema.json",
  "title": "Plan AC frozen atomic query pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_pack_version", "result_format_version", "query_pack_hash", "hash_algorithm", "vocabularies", "lanes"],
  "properties": {
    "query_pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "result_format_version": {"const": "atomic-results-1.0"},
    "query_pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_algorithm": {"const": "sha256-canonical-json-without-query_pack_hash"},
    "vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_status", "evidence_class", "verification_status", "applicability", "pricing_status"],
      "properties": {
        "result_status": {"$ref": "#/definitions/vocabulary"},
        "evidence_class": {"$ref": "#/definitions/vocabulary"},
        "verification_status": {"$ref": "#/definitions/vocabulary"},
        "applicability": {"$ref": "#/definitions/vocabulary"},
        "pricing_status": {"$ref": "#/definitions/vocabulary"}
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oss_invoice", "czech_invoice_software"],
      "properties": {
        "oss_invoice": {"$ref": "#/definitions/lane"},
        "czech_invoice_software": {"$ref": "#/definitions/lane"}
      }
    }
  },
  "definitions": {
    "vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "expected_entity_ids", "fields"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "expected_entity_ids": {
          "type": "array", "minItems": 10, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "fields": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/definitions/field"}
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "importance", "value_type", "comparison_rule", "evidence_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "question": {"type": "string", "minLength": 1},
        "importance": {"enum": ["critical", "noncritical", "pricing"]},
        "value_type": {"enum": ["boolean", "date", "integer", "number", "string", "string_list"]},
        "comparison_rule": {"enum": ["exact", "normalized_set", "numeric_snapshot", "pricing"]},
        "evidence_required": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
