{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tvoje.info/schemas/source-capture-result-1.0.schema.json",
  "title": "Plan AC bounded public source capture result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "mode", "request_sha256", "results", "summary"],
  "properties": {
    "schema_version": {"const": "source-capture-result-1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "mode": {"enum": ["fixture", "live"]},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "results": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/definitions/result"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["captured", "unproven", "invalid"],
      "properties": {
        "captured": {"type": "integer", "minimum": 0},
        "unproven": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0}
      }
    }
  },
  "definitions": {
    "base": {
      "type": "object",
      "required": ["id", "requested_url", "state", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "requested_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "state": {"enum": ["captured", "unproven", "invalid"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "excerpt": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_target", "selector", "terms", "matched_terms", "span", "sha256", "characters", "truncated", "path"],
      "properties": {
        "claim_target": {"type": "string", "minLength": 1, "maxLength": 160},
        "selector": {"const": "term-window"},
        "terms": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}, "uniqueItems": true},
        "matched_terms": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}, "uniqueItems": true},
        "span": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "characters": {"type": "integer", "minimum": 1, "maximum": 500},
        "truncated": {"type": "boolean"},
        "path": {"type": "string", "pattern": "^excerpts/[a-z0-9][a-z0-9._-]{0,79}\\.txt$"}
      }
    },
    "captured": {
      "allOf": [
        {"$ref": "#/definitions/base"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "requested_url", "state", "reason", "final_url", "redirect_chain", "requested_method", "performed_methods", "http_status", "retrieved_at", "content_type", "response_sha256", "response_bytes", "excerpt"],
          "properties": {
            "id": {"type": "string"}, "requested_url": {"type": "string"},
            "state": {"const": "captured"}, "reason": {"type": "null"},
            "final_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "redirect_chain": {"type": "array", "maxItems": 5, "items": {
              "type": "object", "additionalProperties": false, "required": ["status", "from", "to"],
              "properties": {"status": {"enum": [301, 302, 303, 307, 308]}, "from": {"type": "string"}, "to": {"type": "string"}}
            }},
            "requested_method": {"enum": ["HEAD", "GET"]},
            "performed_methods": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"enum": ["HEAD", "GET"]}},
            "http_status": {"type": "integer", "minimum": 200, "maximum": 399},
            "retrieved_at": {"type": "string", "format": "date-time"},
            "content_type": {"type": ["string", "null"]},
            "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "response_bytes": {"type": "integer", "minimum": 0, "maximum": 2000000},
            "excerpt": {"oneOf": [{"$ref": "#/definitions/excerpt"}, {"type": "null"}]}
          }
        }
      ]
    },
    "not_captured": {
      "allOf": [
        {"$ref": "#/definitions/base"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "requested_url", "state", "reason"],
          "properties": {
            "id": {"type": "string"}, "requested_url": {"type": "string"},
            "state": {"enum": ["unproven", "invalid"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "result": {"oneOf": [{"$ref": "#/definitions/captured"}, {"$ref": "#/definitions/not_captured"}]}
  }
}
