#!/bin/bash
# Pre-commit hook for prace-v-nemecku
# Location: .git/hooks/pre-commit
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# What it does:
#  1. Blocks PII-bearing paths (forbidden_paths) from being staged
#  2. Runs package-specific checks via validate_change_packages.py
#  3. Warns on quarantined packages that require explicit approval
#
# To bypass (NOT recommended): git commit --no-verify

set -euo pipefail

echo "=== pre-commit: change package validation ==="

# 1. Block forbidden PII paths from ever being staged (anchored to path boundaries)
FORBIDDEN_PATTERNS="(^|/)a1/|(^|/)scans/|(^|/)evidence/|(^|/)ocr/|(^|/)data/|(^|/)employees/scans/|(^|/)output/|(^|/)runtime/portal/|(^|/)secrets/|\.env$|(^|/).history-remediation/|(^|/)private/|(^|/)reports/"

STAGED=$(git diff --cached --name-only 2>/dev/null || echo "")
if [[ -n "$STAGED" ]]; then
    BLOCKED=$(echo "$STAGED" | grep -E "$FORBIDDEN_PATTERNS" || true)
    if [[ -n "$BLOCKED" ]]; then
        echo "BLOCKED: Forbidden PII path(s) staged:"
        echo "$BLOCKED"
        echo ""
        echo "Never stage files in these paths. Stage only non-PII files."
        echo "If you need to stage workflow structure, stage specific files explicitly."
        exit 1
    fi
fi

# 2. No staged files = nothing to validate
if [[ -z "$STAGED" ]]; then
    echo "SKIP: No staged files"
    exit 0
fi

# 3. Run validate_change_packages.py to classify and get checks
REPORT=$(python3 scripts/validate_change_packages.py --json 2>/dev/null || echo "{}")

# Extract problems from the report
PROBLEMS=$(echo "$REPORT" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    problems = data.get('problems', [])
    if problems:
        for p in problems:
            print(f'PROBLEM: {p}')
    else:
        print('NONE')
except:
    print('NONE')
" 2>/dev/null || echo "NONE")

if [[ "$PROBLEMS" != "NONE" ]] && [[ -n "$PROBLEMS" ]]; then
    echo "PATH CLASSIFICATION ERRORS:"
    echo "$PROBLEMS"
    exit 1
fi

# 4. Extract package-specific checks and run them
CHECKS=$(echo "$REPORT" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    entries = data.get('entries', [])
    packages = {}
    for e in entries:
        pkg = e.get('package')
        if pkg and pkg not in packages:
            packages[pkg] = True
    receipts = data.get('package_receipts', [])
    all_checks = []
    for r in receipts:
        if r.get('package') in packages:
            all_checks.extend(r.get('checks', []))
    print('|'.join(all_checks) if all_checks else '')
except:
    print('')
" 2>/dev/null || echo "")

if [[ -n "$CHECKS" ]]; then
    echo "Running package checks..."
    FAILED=0
    IFS='|' read -ra CHECK_ARRAY <<< "$CHECKS"
    for check in "${CHECK_ARRAY[@]}"; do
        if [[ -z "$check" ]]; then continue; fi
        echo "  → $check"
        if ! eval "$check" >/dev/null 2>&1; then
            echo "  FAILED: $check"
            FAILED=1
        else
            echo "  PASSED"
        fi
    done

    if [[ $FAILED -eq 1 ]]; then
        echo ""
        echo "COMMIT BLOCKED: One or more package checks failed."
        echo "Fix failures before committing."
        exit 1
    fi
fi

# 5. Block staged files belonging to quarantined packages (eligible_for_staging: false)
# A staged path that the validator classifies as ineligible_for_staging requires
# explicit operator approval documented outside change-packages.yml. Refuse the
# commit so the operator either unstages the path or proceeds with --no-verify
# after recording the approval.
BLOCKED_QUARANTINED=$(echo "$REPORT" | STAGED="$STAGED" python3 -c "
import json, os, sys
try:
    data = json.load(sys.stdin)
    entries = data.get('entries', [])
    quarantined = {e['path'] for e in entries if not e.get('eligible_for_staging', True)}
    staged_lines = [line for line in os.environ.get('STAGED', '').splitlines() if line]
    blocked = sorted(p for p in staged_lines if p in quarantined)
    for p in blocked:
        print(p)
except Exception:
    pass
" 2>/dev/null || echo "")

if [[ -n "$BLOCKED_QUARANTINED" ]]; then
    echo ""
    echo "BLOCKED: Staged files belong to quarantined package(s) (eligible_for_staging: false):"
    echo "$BLOCKED_QUARANTINED"
    echo ""
    echo "These require explicit operator approval before staging."
    echo "Unstage them ('git restore --staged <path>') or use 'git commit --no-verify'"
    echo "after recording the approval in the relevant plan or ADR."
    exit 1
fi

echo "=== pre-commit: PASSED ==="
exit 0
